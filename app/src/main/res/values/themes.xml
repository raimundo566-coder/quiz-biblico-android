<resources xmlns:tools="http://schemas.android.com/tools">
    <style name="Base.Theme.QuizBiblico" parent="Theme.Material3.DayNight.NoActionBar">
        <item name="android:windowBackground">@drawable/bg_pergaminho_janela</item>
        <item name="colorPrimary">@color/qb_azul_botao</item>
        <item name="materialAlertDialogTheme">@style/ThemeOverlay.QuizBiblico.Dialogo</item>
        <item name="android:textColorPrimary">@color/qb_texto_claro</item>
        <item name="android:textColorSecondary">@color/qb_texto_claro</item>
    </style>

    <style name="Theme.QuizBiblico" parent="Base.Theme.QuizBiblico" />

    <style name="Widget.QuizBiblico.BotaoMenu" parent="Widget.Material3.Button">
        <item name="cornerRadius">28dp</item>
        <item name="strokeColor">@color/qb_dourado</item>
        <item name="strokeWidth">1.5dp</item>
        <item name="backgroundTint">@color/qb_azul_botao</item>
        <item name="android:textColor">@color/qb_dourado</item>
        <item name="android:textAllCaps">false</item>
        <item name="android:letterSpacing">0.02</item>
        <item name="android:insetTop">0dp</item>
        <item name="android:insetBottom">0dp</item>
    </style>

    <style name="Widget.QuizBiblico.Botao" parent="Widget.AppCompat.Button">
        <item name="android:background">@drawable/botao_couro</item>
        <item name="android:stateListAnimator">@animator/botao_pressionado</item>   <!-- ESTA linha é nova -->
        <item name="android:textColor">@color/qb_dourado</item>
        <item name="android:textAllCaps">false</item>
        <item name="android:letterSpacing">0.02</item>
        <item name="android:paddingStart">16dp</item>
        <item name="android:paddingEnd">16dp</item>
    </style>

    <style name="Widget.QuizBiblico.Titulo" parent="android:Widget.TextView">
        <item name="android:textColor">@color/qb_dourado</item>
        <item name="android:textSize">24sp</item>
        <item name="android:textStyle">bold</item>
        <item name="android:shadowColor">#CC000000</item>
        <item name="android:shadowDx">0</item>
        <item name="android:shadowDy">3</item>
        <item name="android:shadowRadius">8</item>
    </style>
    <style name="ThemeOverlay.QuizBiblico.Dialogo" parent="ThemeOverlay.Material3.MaterialAlertDialog">
        <item name="colorSurface">@color/qb_fundo_dialogo</item>
        <item name="colorOnSurface">@color/qb_texto_claro</item>
        <item name="colorOnSurfaceVariant">@color/qb_texto_claro</item>
        <item name="buttonBarPositiveButtonStyle">@style/Widget.QuizBiblico.BotaoDialogo</item>
        <item name="buttonBarNegativeButtonStyle">@style/Widget.QuizBiblico.BotaoDialogo</item>
    </style>

    <style name="Widget.QuizBiblico.BotaoDialogo" parent="Widget.Material3.Button.TextButton.Dialog">
        <item name="android:textColor">@color/qb_branco</item>
        <item name="android:textStyle">bold</item>
        <item name="android:textSize">15sp</item>
    </style>
</resources>