<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:gravity="center"
    android:padding="24dp">

    <TextView
        style="@style/Widget.QuizBiblico.Titulo"
        android:layout_width="177dp"
        android:layout_height="56dp"
        android:layout_marginBottom="35dp"
        android:text="MODO SOLO"
        android:textSize="30sp" />

    <androidx.appcompat.widget.AppCompatButton
        android:id="@+id/botaoPorLivro"
        style="@style/Widget.QuizBiblico.Botao"
        android:layout_width="411dp"
        android:layout_height="94dp"
        android:layout_marginBottom="12dp"
        android:text="Por livro"
        android:textSize="20sp"/>

    <androidx.appcompat.widget.AppCompatButton
        android:id="@+id/botaoPorTestamento"
        style="@style/Widget.QuizBiblico.Botao"
        android:layout_width="411dp"
        android:layout_height="96dp"
        android:layout_marginBottom="12dp"
        android:textSize="20sp"
        android:text="Por testamento"/>


    <androidx.appcompat.widget.AppCompatButton
        android:id="@+id/botaoGeral"
        style="@style/Widget.QuizBiblico.Botao"
        android:layout_width="411dp"
        android:layout_height="90dp"
        android:layout_marginBottom="12dp"
        android:text="Geral (a Biblia toda)"
        android:textSize="20sp"/>

    <androidx.appcompat.widget.AppCompatButton
        android:id="@+id/botaoVoltar"
        style="@style/Widget.QuizBiblico.Botao"
        android:layout_width="411dp"
        android:layout_height="84dp"
        android:text="Voltar"
        android:textSize="20sp"/>

</LinearLayout>